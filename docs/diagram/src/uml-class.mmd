---
title: UML Class Diagram — Model Domain Kato Report
---
classDiagram
  direction LR

  class CleaningArea {
    +id : String «PK»
    +name : String
    +buildingCode : String
    +floor : Integer
    +tasks : CleaningTask[]
    +sortOrder : Integer
    +active : Boolean
  }
  class User {
    +id : String «PK»
    +username : String
    +name : String
    +role : Role
    -passwordHash : String
    -passwordSalt : String
    +active : Boolean
    +createdAt : DateTime
    +login(username, password) Session
    +registerReporter(username, name, password)
    +addStaff(name)
    +addSupervisor(username, name, password)
    +updateAccount(data)
    +deleteAccount(id)
  }
  class Report {
    +id : String «PK»
    +areaId : String «FK»
    +toiletId : String «FK» «data lama»
    +reporterId : String «FK»
    +description : String
    +photoKey : String
    +status : ReportStatus
    +staffName : String
    +resolvedAt : DateTime
    +aiStatus : AiStatus
    +categories : Category[]
    +priority : Priority
    +summary : String
    +recommendation : String
    +proofPhotoKey : String
    +proofVerdict : ProofVerdict «data lama»
    +proofReason : String «data lama»
    +createdAt : DateTime
    +submit(areaId, description, photoKey)
    +runAnalysis()
    +changeStatus(status, staff, proofPhotoKey)
    +canResolve(status, proofPhoto) Boolean$
    +reopen(actor)
    +requestReanalysis()
    +delete(actor)
  }
  class CleaningReport {
    +id : String «PK»
    +areaId : String «FK»
    +staffId : String «FK»
    +staffName : String
    +note : String
    +latitude : Real
    +longitude : Real
    +accuracyM : Real
    +distanceM : Real
    +locationStatus : LocationStatus
    +createdAt : DateTime
    +submit(areaId, tasks, note, position)
  }
  class CleaningReportTask {
    +reportId : String «FK»
    +task : CleaningTask
    +photoKey : String «unik»
    +photoAt : DateTime
  }
  class DailySummary {
    +date : Date «PK»
    +reportCount : Integer
    +summary : String
    +highlights : String[]
    +createdAt : DateTime
    +generate(date)$
  }
  class ActivityLog {
    +id : Integer «PK»
    +createdAt : DateTime
    +action : String
    +reportId : String
    +actor : String
    +summary : String
    +details : JSON
    +log(action, actor, summary)$
  }
  class Toilet {
    <<data lama>>
    +id : String «PK»
    +buildingCode : String
    +floor : Integer
    +type : String
    +active : Boolean
  }

  note "Daftar nilai tetap (enumeration)<br/>Role: supervisor | staff | reporter<br/>ReportStatus: new | in_progress | resolved<br/>Priority: low | medium | high<br/>Category: cleanliness | supplies | damage | odor | flooding | other<br/>ProofVerdict (data lama): clean | dirty | wrong_place<br/>AiStatus: pending | ok | failed<br/>CleaningTask: sweep_mop | glass | toilet | trash | gallon | tidy<br/>(data lama: sweep, mop)<br/>LocationStatus: ok | far | unknown"

  CleaningArea "1" <-- "0..*" CleaningReport : dikerjakan di
  User "1" <-- "0..*" CleaningReport : dilaporkan oleh (petugas)
  CleaningReport "1" *-- "1..6" CleaningReportTask : memuat
  CleaningArea "1" <-- "0..*" Report : dilaporkan pada
  Toilet "0..1" <-- "0..*" Report : dilaporkan pada (data lama)
  User "0..1" <-- "0..*" Report : dibuat oleh (pelapor)
  Report "0..1" <.. "0..*" ActivityLog : mencatat
  DailySummary ..> Report : merangkum
