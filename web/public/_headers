# Cache rules for the static files served by Workers Static Assets.
# Built JS and CSS carry a content hash in their name, so they never change in
# place and can be kept forever. Images keep a week; index.html is left to the
# default (always revalidated), so a deploy shows up on the next visit.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/peta-lokasi-gedung.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
