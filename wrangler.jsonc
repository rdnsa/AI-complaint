{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-complaint",
  // This OAuth token can reach several accounts; name the one that owns D1 & R2 "kato".
  "account_id": "2b672ad4e8f27a584bd22e9ec749e326",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // The frontend is built automatically before deploying, so `wrangler deploy`
  // never finds ./dist empty.
  "build": {
    "command": "node scripts/build-frontend.mjs"
  },

  // The React frontend (output of `npm run build`) is served by this same Worker.
  // run_worker_first: /api/* always reaches the Worker, everything else is a static file.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /api/* must reach the Worker first. Any other path that matches no static
    // file (e.g. /lapor/A-1) is returned as index.html so React routing works;
    // without this the asset server would redirect to "/" instead.
    // "/__scheduled" is only used by `wrangler dev --test-scheduled` to fire the
    // cron by hand; without this exception it would be swallowed by the SPA fallback.
    "run_worker_first": ["/api/*", "/__scheduled"],
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kato",
      "database_id": "1b221b2c-3de3-4368-857f-0ee6515ea1d6",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kato"
    }
  ],

  // Automatic daily summary: 10:00 UTC == 17:00 WIB
  "triggers": {
    "crons": ["0 10 * * *"]
  },

  "vars": {
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-chat",
    // deepseek-chat cannot see images, so proof photos are judged by a separate
    // vision model. Any OpenAI-compatible chat endpoint that accepts image_url
    // works; e.g. OpenAI "https://api.openai.com/v1" + "gpt-4o-mini", or
    // OpenRouter "https://openrouter.ai/api/v1" + any vision model there.
    "VISION_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "VISION_MODEL": "gemini-3.6-flash"
  }

  // Secrets (do NOT put them here, use `wrangler secret put`):
  //   LLM_API_KEY
  //   VISION_API_KEY   (optional: falls back to LLM_API_KEY when both models share a provider)
  //   AUTH_SECRET

}
